{
  "manifest_version": 3,
  "name": "HoloTL — Live JP Subtitles (Gemini)",
  "version": "0.1.0",
  "description": "Live-translates Japanese audio from this tab into subtitles using the Gemini API, with in-browser Silero VAD chunking and a per-stream cost meter.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background/service-worker.js" },
  "action": {
    "default_title": "HoloTL",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
